{
  "name": "@najororabiaza/kalendar",
  "version": "1.1.0",
  "description": "Composant React d'emploi du temps universitaire connecte a Google Calendar. Personnalisable via CSS Variables, props React, ou parametres URL.",
  "author": "NajoroRabiaza",
  "license": "MIT",
  "homepage": ".",
  "repository": {
    "type": "git",
    "url": "https://github.com/NajoroRabiaza/Kalendar.git"
  },
  "keywords": [
    "react",
    "calendar",
    "google-calendar",
    "timetable",
    "emploi-du-temps",
    "university",
    "fullcalendar",
    "madagascar"
  ],
  "private": false,
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./dist/kalendar.css": "./dist/kalendar.css"
  },
  "files": [
    "dist/index.es.js",
    "dist/index.cjs.js",
    "dist/index.d.ts",
    "dist/kalendar.css",
    "lib/README.npm.md",
    "lib/README.md"
  ],
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:lib": "vitest run --config vitest.config.ts",
    "test:lib:watch": "vitest --config vitest.config.ts",
    "eject": "react-scripts eject",
    "build:lib": "vite build --config vite.config.lib.js",
    "prepublishOnly": "pnpm run build:lib"
  },
  "peerDependencies": {
    "@fullcalendar/core": ">=6.0.0",
    "@fullcalendar/daygrid": ">=6.0.0",
    "@fullcalendar/google-calendar": ">=6.0.0",
    "@fullcalendar/react": ">=6.0.0",
    "@fullcalendar/timegrid": ">=6.0.0",
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/google-calendar": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.0.0",
    "web-vitals": "^2.1.4"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "readme": "lib/README.md",
  "style": "dist/kalendar.css",
  "sideEffects": [
    "dist/kalendar.css",
    "*.css"
  ]
}
